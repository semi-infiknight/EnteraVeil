{
  "kind": "collectionType",
  "collectionName": "homepage_sections",
  "info": {
    "singularName": "homepage-section",
    "pluralName": "homepage-sections",
    "displayName": "Homepage section",
    "description": "Hero / featured / lookbook tiles on the home page, sorted by sort_order."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": ["hero", "featured", "lookbook", "promo", "newsletter"],
      "required": true,
      "default": "featured"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "cta_text": {
      "type": "string"
    },
    "cta_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  }
}
