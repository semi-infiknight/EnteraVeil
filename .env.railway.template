# EnteraVeil — Railway production variables template
# Copy values into Railway service variables (or use scripts/railway-set-secrets.sh).
# NEVER commit real secrets.

# --- Shared / derived automatically by .railway/railway.ts ---
# DATABASE_URL, REDIS_URL, PG*, cross-service RAILWAY_PUBLIC_DOMAIN refs

# --- Medusa (service: medusa) ---
JWT_SECRET=                 # openssl rand -hex 32
COOKIE_SECRET=              # openssl rand -hex 32
RAZORPAY_ID=                # optional until live — COD still works
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT=
RESEND_API_KEY=             # optional until domain verified
RESEND_FROM_EMAIL=orders@enteraveil.com
ADMIN_EMAIL=

# --- DigitalOcean Spaces (optional — leave blank for local file storage) ---
DO_SPACE_URL=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_REGION=blr1
DO_SPACE_BUCKET=
DO_SPACE_ENDPOINT=

# --- Storefront (service: storefront) — required at BUILD time ---
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=   # from Medusa admin after first boot
NEXT_PUBLIC_RAZORPAY_KEY_ID=          # same as RAZORPAY_ID when enabled
STRAPI_API_TOKEN=                     # from Strapi admin after first boot
STRAPI_WEBHOOK_REVALIDATION_SECRET=   # openssl rand -hex 32

# --- Strapi (service: strapi) ---
APP_KEYS=                   # 4 comma-separated: openssl rand -base64 16
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=