# EnteraVeil production .env template
# Copy to .env.prod on the VPS (or symlink) and fill in real values.
# NEVER commit .env.prod — it's in .gitignore.

# --- Infra ---
BRAND_DOMAIN=enteraveil.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=          # generate: openssl rand -hex 24
POSTGRES_DB=medusa-store

# --- Medusa secrets ---
JWT_SECRET=                 # generate: openssl rand -hex 32
COOKIE_SECRET=              # generate: openssl rand -hex 32

# --- Razorpay (LIVE keys from dashboard after KYC; TEST keys OK to start) ---
RAZORPAY_ID=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT=

# --- Resend (LIVE key from resend.com; domain must be verified) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@enteraveil.com
ADMIN_EMAIL=                # your real inbox

# --- DigitalOcean Spaces (S3-compatible product image storage) ---
DO_SPACE_URL=
DO_SPACE_ACCESS_KEY=
DO_SPACE_SECRET_KEY=
DO_SPACE_REGION=blr1
DO_SPACE_BUCKET=
DO_SPACE_ENDPOINT=

# --- Strapi secrets (regenerate per environment) ---
APP_KEYS=                   # comma-separated, 4 strings, openssl rand -base64 16
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=
STRAPI_ENCRYPTION_KEY=

# --- Storefront client config ---
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_SHOP_NAME=EnteraVeil
NEXT_PUBLIC_SHOP_DESCRIPTION=Anime streetwear from beyond the veil

# --- Storefront ↔ Strapi revalidation handshake ---
STRAPI_API_TOKEN=
STRAPI_WEBHOOK_REVALIDATION_SECRET=

# --- VPS access (used by deploy.sh) ---
VPS_HOST=
VPS_USER=root
